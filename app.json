{
  "expo": {
    "name": "Kagainz",
    "slug": "kagainz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kagainz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.tanvogue.kagainz"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08090B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "xyz.tanvogue.kagainz"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#08090B",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#08090B"
          }
        }
      ],
      "expo-font",
      "expo-video",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Barkod okutmak ve form check videosu çekmek için kameraya erişim gerekiyor.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chat'te fotoğraf paylaşmak, öğün fotoğrafından makro hesaplamak ve form check videosu seçmek için galerine erişim gerekiyor.",
          "cameraPermission": "Öğün fotoğrafı ve form check videosu çekmek için kameraya erişim gerekiyor.",
          "microphonePermission": "Form check videosunu sesli kaydetmek için mikrofona erişim gerekiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3B82F6"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "xyz.tanvogue.kagainz.widgets",
          "groupIdentifier": "group.xyz.tanvogue.kagainz",
          "widgets": [
            {
              "name": "KagainzToday",
              "displayName": "Kagainz Bugün",
              "description": "Kalan kalori, protein ve su hedefin.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular",
                "accessoryRectangular"
              ]
            }
          ]
        }
      ],
      "expo-sharing",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "Chat'te sesli mesaj gönderebilmen için mikrofona erişim gerekiyor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
